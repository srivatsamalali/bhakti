rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Songs collection: Public read and manage
    match /songs/{songId} {
      allow read, write: if true;
    }

    // Categories collection: Public read and manage
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // App Configuration collection: Public read and manage
    match /app_config/{configId} {
      allow read, write: if true;
    }

    // Admin profiles
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}

